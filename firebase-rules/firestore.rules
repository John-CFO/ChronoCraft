rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Deny-all catch-all for sensitive sub-trees.
    match /security/{document=**} {
      allow read, write: if false;
    }

    match /Users/{userId} {
      // ------------------------------------------------------------
      // WARNING: REQUIRES MANUAL - schema: FirestoreUserUpdateSchema
      // ------------------------------------------------------------
      // .strict() detected - define the field whitelist yourself.
      // Candidates: displayName, personalNumber, photoURL
      // (add server-managed fields like uid, createdAt if present)
      //
      // - displayName: Complex validation (refine) detected
      // - personalNumber: Complex validation (refine) detected
      // - photoURL: z.url() requires manual regex implementation
      //
      // Suggested create rule (uncomment and adapt):
      // // allow create: if isOwner(userId)
      // //   && request.resource.data.keys().hasOnly(["displayName", "personalNumber", "photoURL"]);
      // ------------------------------------------------------------
      function hasRequired_FirestoreUserUpdateSchema() {
        return ((!("displayName" in request.resource.data) || request.resource.data.displayName is string) && (!("personalNumber" in request.resource.data) || request.resource.data.personalNumber is string) && (!("photoURL" in request.resource.data) || request.resource.data.photoURL is string));
      }
      allow read:   if isOwner(userId);
      allow list:   if false;
      allow create: if isOwner(userId) && hasRequired_FirestoreUserUpdateSchema();
      allow update: if isOwner(userId) && hasRequired_FirestoreUserUpdateSchema();
      allow delete: if false;
      
      match /Services/{serviceId} {
        allow read:   if isOwner(userId);
        allow list:   if false;
        allow create: if isOwner(userId);
        allow update: if false;
        allow delete: if false;

        match /Projects/{projectId} {
          function hasRequired_ProjectStateSchema() {
            return (("id" in request.resource.data && request.resource.data.id is string && request.resource.data.id.size() >= 1 && request.resource.data.id.size() <= 100) && (!("name" in request.resource.data) || request.resource.data.name is string && request.resource.data.name.size() <= 200) && ("timer" in request.resource.data && request.resource.data.timer is number && request.resource.data.timer >= 0 && request.resource.data.timer <= 315360000) && ("isTracking" in request.resource.data && request.resource.data.isTracking is bool) && ("startTime" in request.resource.data && (request.resource.data.startTime == null || (request.resource.data.startTime is timestamp))) && ("pauseTime" in request.resource.data && (request.resource.data.pauseTime == null || (request.resource.data.pauseTime is timestamp))) && ("hourlyRate" in request.resource.data && request.resource.data.hourlyRate is number && request.resource.data.hourlyRate >= 0 && request.resource.data.hourlyRate <= 10000) && ("elapsedTime" in request.resource.data && request.resource.data.elapsedTime is number && request.resource.data.elapsedTime >= 0 && request.resource.data.elapsedTime <= 315360000) && ("totalEarnings" in request.resource.data && request.resource.data.totalEarnings is number && request.resource.data.totalEarnings >= 0 && request.resource.data.totalEarnings <= 10000000) && (!("projectName" in request.resource.data) || request.resource.data.projectName is string && request.resource.data.projectName.size() <= 200) && ("originalStartTime" in request.resource.data && (request.resource.data.originalStartTime == null || (request.resource.data.originalStartTime is timestamp))) && ("lastStartTime" in request.resource.data && (request.resource.data.lastStartTime == null || (request.resource.data.lastStartTime is timestamp))) && ("endTime" in request.resource.data && (request.resource.data.endTime == null || (request.resource.data.endTime is timestamp))) && ("maxWorkHours" in request.resource.data && request.resource.data.maxWorkHours is number && request.resource.data.maxWorkHours >= 0 && request.resource.data.maxWorkHours <= 8760) && ("isRestoring" in request.resource.data && request.resource.data.isRestoring is bool));
          }
          allow read:   if isOwner(userId);
          allow list:   if false;
          allow create: if isOwner(userId) && hasRequired_ProjectStateSchema();
          allow update: if isOwner(userId) && hasRequired_ProjectStateSchema();
          allow delete: if isOwner(userId);

          match /Notes/{id} {
            allow read:   if isOwner(userId);
            allow list:   if false;
            allow create: if isOwner(userId);
            allow update: if isOwner(userId);
            allow delete: if isOwner(userId);
          }
        }

        match /Vacations/{vacationId} {
          // ------------------------------------------------------------
          // WARNING: REQUIRES MANUAL - schema: VacationInputSchema
          // ------------------------------------------------------------
          // - markedDates: Reference to external schema: MarkedDatesSchema
          // ------------------------------------------------------------
          function hasRequired_VacationInputSchema() {
            return (("uid" in request.resource.data && request.resource.data.uid is string) && ("startDate" in request.resource.data && request.resource.data.startDate is string && request.resource.data.startDate.matches("^\\d{4}-\\d{2}-\\d{2}$")) && ("markedDates" in request.resource.data && request.resource.data.markedDates is map));
          }
          allow read:   if isOwner(userId);
          allow list:   if false;
          allow create: if isOwner(userId) && hasRequired_VacationInputSchema();
          allow update: if isOwner(userId) && hasRequired_VacationInputSchema();
          allow delete: if isOwner(userId);
        }

        match /WorkHours/{targetDay} {
          allow read:   if isOwner(userId);
          allow list:   if false;
          allow create: if isOwner(userId);
          allow update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
